---
import Project from "./Project.astro";
import Heading from "../ui/Heading.astro";
import { Icon } from "astro-icon/components";

interface Post {
  url: string;
  frontmatter: {
    title: string;
    pubDate: string;
    description: string;
    languages: string[];
    image: {
      url: string;
      alt: string;
    };
  };
}

const allPostsGlob = import.meta.glob("../../pages/portfolio/projects/*.md", {
  eager: true,
});
const allPosts = (Object.values(allPostsGlob) as unknown as Post[]).sort(
  (a, b) =>
    new Date(b.frontmatter.pubDate).getTime() -
    new Date(a.frontmatter.pubDate).getTime(),
);
---

<section
  class="bg-linear-to-t dark:from-[#0e0e10] from-white from-50% to-transparent to-100% scroll-m-16 relative pt-8 pb-12 max-2xl:px-8 max-md:pt-4"
  id="projects"
>
  <div class="mx-auto max-w-7xl py-8">
    <div class="flex gap-4 items-center justify-center text-center">
      <Icon class="text-3xl dark:text-white text-blacktext" name="code" />
      <Heading text="Projects" textGradient="Completed" level={2} />
    </div>
    <slot />
  </div>

  <div
    id="projectsWrapper"
    class="max-h-[150vh] overflow-hidden transition-[max-height] duration-500 ease-in-out relative"
  >
    <div
      id="containerProjects"
      class="mx-auto max-w-7xl w-full columns-1 md:columns-2 lg:columns-3 gap-5 p-2 py-4"
    >
      {
        allPosts.map((post) => (
          <Project
            url={post.url}
            title={post.frontmatter.title}
            description={post.frontmatter.description}
            date={post.frontmatter.pubDate}
            languages={post.frontmatter.languages}
            image={post.frontmatter.image}
          />
        ))
      }
    </div>

    <div
      id="moreProjects"
      class="absolute bottom-0 left-0 w-full flex justify-center text-center bg-linear-to-t from-[#FBFEFD] dark:from-[#0e0e10] from-50% to-transparent to-100% pb-12 pt-40 pointer-events-none"
    >
      <button
        class="pointer-events-auto font-bold cursor-pointer text-mint-400 dark:text-mint-100 hover:text-mint-500 dark:hover:text-mint-300 transition-all bg-white/10 backdrop-blur-md px-6 py-2 rounded-full border border-white/20 shadow-lg"
      >
        View More Projects...
      </button>
    </div>
  </div>
</section>
<script>
  const btnContainer = document.querySelector("#moreProjects");
  const btn = btnContainer?.querySelector("button");

  btn?.addEventListener("click", () => {
    const wrapper = document.querySelector("#projectsWrapper") as HTMLElement;
    const container = document.querySelector(
      "#containerProjects",
    ) as HTMLElement;

    if (wrapper && container && btnContainer) {
      // 1. Get full height from the inner container
      const fullHeight = container.scrollHeight + "px";

      // 2. Expand wrapper
      wrapper.style.maxHeight = fullHeight;

      // 3. Hide button container with fade out
      btnContainer.classList.add("opacity-0");

      // 4. Remove overflow restriction after animation
      setTimeout(() => {
        wrapper.classList.remove("overflow-hidden");
        wrapper.style.maxHeight = "none";
        btnContainer.remove(); // Remove purely from DOM
      }, 500);
    }
  });
</script>
